{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(actionlint:*)",
      "Bash(yamllint:*)",
      "Bash(yq:*)",
      "Bash(jq:*)",
      "Bash(gh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(grep:*)",
      "Bash(find . *)",
      "Bash(find ./*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(bash scripts/claude-hook-*:*)"
    ],
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git tag -d:*)",
      "Bash(git push origin --delete:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hook-postedit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hook-stop.sh"
          }
        ]
      }
    ]
  }
}
